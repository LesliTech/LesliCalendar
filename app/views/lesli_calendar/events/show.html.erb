<%= turbo_frame_tag "calendar-event-detail" do %>
    <%= render LesliView::Layout::Container.new("event-show") do %>
        <%= render LesliView::Components::Header.new(@event.title, back: turbo_frame_request? ? nil : events_path) do %>
            <%= render "actions" unless turbo_frame_request? %>
        <% end %>
        <%= render "event" %>
        <% if turbo_frame_request? && @event.user_id == current_user.id %>
            <div class="mt-4 flex flex-wrap gap-3" role="group" aria-label="<%= t('actions.label', default: 'Page actions') %>">
                <%= render "actions" %>
            </div>
        <% end %>
    <% end %>
<% end %>
