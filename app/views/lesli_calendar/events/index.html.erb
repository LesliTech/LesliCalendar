<%= render LesliView::Layout::Container.new("events-index") do %>
    <%= render LesliView::Components::Header.new(@list_title) do %>
        <%= render LesliView::Elements::Button.new(t("lesli_calendar.events.new"), url: new_event_path, icon: "add") %>
    <% end %>
    <div class="mb-5 flex flex-wrap gap-3">
        <%= render LesliView::Elements::Button.new(t("lesli_calendar.events.mine"), url: events_path, solid: false) %>
        <%= render LesliView::Elements::Button.new(t("lesli_calendar.events.pending"), url: pending_events_path, solid: false) %>
        <%= render LesliView::Elements::Button.new(t("lesli_calendar.events.available"), url: available_events_path, solid: false) %>
        <%= render LesliView::Elements::Button.new(t("lesli_calendar.calendars.title"), url: calendar_path, solid: false) %>
    </div>
    <%= render LesliView::Elements::Table.new(
        columns: [:title, :start_at, :status].map { |field| { field: field, label: t("lesli_calendar.events.#{field}") } },
        records: @events.map { |event| { id: event.id, title: event.title,
            start_at: "#{l(event.start_at.utc, format: :long)} UTC", status: t("lesli_calendar.events.statuses.#{event.status}") } },
        link: ->(event) { event_path(event.fetch(:id)) }, empty: t("lesli_calendar.events.empty")
    ) %>
<% end %>
