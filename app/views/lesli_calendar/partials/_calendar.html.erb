<div class="lesli-calendar-calendar mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white p-0 shadow-sm">
    <%# The custom element owns the FullCalendar render and Turbo lifecycle. %>
    <lesli-calendar
        id="lesli-calendar-engine"
        class="block"
        data-locale="<%= I18n.locale %>"
        data-title-id="calendar-period"
        data-status-id="calendar-status"
        data-loading-message="<%= t('lesli_calendar.calendars.loading') %>"
        data-empty-message="<%= t('lesli_calendar.calendars.empty') %>"
        data-error-message="<%= t('lesli_calendar.calendars.error') %>"
        data-events-url="<%= events_path(format: :json) %>">
    </lesli-calendar>
</div>
